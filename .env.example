# PropriétéGraph Environment Variables
# Copy to .env and configure

# Database
DATABASE_URL=postgresql+asyncpg://propriete:propriete@localhost:5432/propriete_graph
DATABASE_URL_SYNC=postgresql://propriete:propriete@localhost:5432/propriete_graph

# Redis
REDIS_URL=redis://localhost:6379/0

# API settings
DEBUG=false
API_PREFIX=/api/v1

# Data ingestion
# Comma-separated list of department codes to process
DEPARTMENTS=75,69,13,33,31,06,59,67,44,34

# DVF data source (official data.gouv.fr)
DVF_BASE_URL=https://files.data.gouv.fr/geo-dvf/latest/csv

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
